<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.ScheduleMapper">

    <resultMap type="Schedule" id="ScheduleResult">
        <id property="scheduleId" column="schedule_id" />
        <result property="deptId" column="dept_id" />
        <result property="deptName" column="dept_name" />
        <result property="doctorId" column="doctor_id" />
        <result property="doctorName" column="doctor_name" />
        <result property="doctorTitle" column="title" />
        <result property="workDate" column="work_date" />
        <result property="timeSlot" column="time_slot" />
        <result property="quota" column="quota" />
        <result property="remainQuota" column="remain_quota" />
        <result property="status" column="status" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectScheduleVo">
        select t.schedule_id, t.dept_id, t.doctor_id, t.work_date, t.time_slot, t.quota, t.remain_quota, t.status, d.dept_name, doc.doctor_name, doc.title
        from his_schedule t
        left join his_department d on d.dept_id = t.dept_id
        left join his_doctor doc on doc.doctor_id = t.doctor_id
    </sql>

    <select id="selectScheduleList" parameterType="com.ruoyi.his.domain.Schedule" resultMap="ScheduleResult">
        <include refid="selectScheduleVo"/>
        <where>
            <if test="deptId != null"> AND t.dept_id = #{deptId}</if>
            <if test="doctorId != null"> AND t.doctor_id = #{doctorId}</if>
            <if test="workDate != null"> AND t.work_date = #{workDate}</if>
        </where>
        order by t.work_date desc, t.time_slot
    </select>

    <select id="selectScheduleByScheduleId" parameterType="Long" resultMap="ScheduleResult">
        <include refid="selectScheduleVo"/>
        where t.schedule_id = #{scheduleId}
    </select>

    <insert id="insertSchedule" parameterType="com.ruoyi.his.domain.Schedule" useGeneratedKeys="true" keyProperty="scheduleId">
        insert into his_schedule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="workDate != null">work_date,</if>
            <if test="timeSlot != null and timeSlot != ''">time_slot,</if>
            <if test="quota != null">quota,</if>
            <if test="remainQuota != null">remain_quota,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="workDate != null">#{workDate},</if>
            <if test="timeSlot != null and timeSlot != ''">#{timeSlot},</if>
            <if test="quota != null">#{quota},</if>
            <if test="remainQuota != null">#{remainQuota},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSchedule" parameterType="com.ruoyi.his.domain.Schedule">
        update his_schedule
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="workDate != null">work_date = #{workDate},</if>
            <if test="timeSlot != null and timeSlot != ''">time_slot = #{timeSlot},</if>
            <if test="quota != null">quota = #{quota},</if>
            <if test="remainQuota != null">remain_quota = #{remainQuota},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where schedule_id = #{scheduleId}
    </update>

    <delete id="deleteScheduleByScheduleId" parameterType="Long">
        delete from his_schedule where schedule_id = #{scheduleId}
    </delete>

    <delete id="deleteScheduleByScheduleIds" parameterType="String">
        delete from his_schedule where schedule_id in
        <foreach item="scheduleId" collection="array" open="(" separator="," close=")">
            #{scheduleId}
        </foreach>
    </delete>

    <update id="decrQuota" parameterType="Long">
        update his_schedule set remain_quota = remain_quota - 1
        where schedule_id = #{scheduleId} and remain_quota &gt; 0
    </update>

    <update id="incrQuota" parameterType="Long">
        update his_schedule set remain_quota = least(quota, remain_quota + 1)
        where schedule_id = #{scheduleId}
    </update>

    <select id="selectAvailable" parameterType="com.ruoyi.his.domain.Schedule" resultMap="ScheduleResult">
        <include refid="selectScheduleVo"/>
        <where>
            t.remain_quota &gt; 0 and t.status = '0'
            <if test="deptId != null"> AND t.dept_id = #{deptId}</if>
            <if test="doctorId != null"> AND t.doctor_id = #{doctorId}</if>
            <if test="workDate != null"> AND t.work_date = #{workDate}</if>
        </where>
        order by t.work_date, t.time_slot
    </select>
</mapper>
