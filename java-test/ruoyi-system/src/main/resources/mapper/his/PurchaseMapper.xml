<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.PurchaseMapper">

    <resultMap type="Purchase" id="PurchaseResult">
        <id property="purchaseId" column="purchase_id" />
        <result property="purchaseNo" column="purchase_no" />
        <result property="supplierId" column="supplier_id" />
        <result property="supplierName" column="supplier_name" />
        <result property="totalAmount" column="total_amount" />
        <result property="status" column="status" />
        <result property="inTime" column="in_time" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectPurchaseVo">
        select t.purchase_id, t.purchase_no, t.supplier_id, t.total_amount, t.status, t.in_time, s.supplier_name
        from his_purchase t
        left join his_supplier s on s.supplier_id = t.supplier_id
    </sql>

    <select id="selectPurchaseList" parameterType="com.ruoyi.his.domain.Purchase" resultMap="PurchaseResult">
        <include refid="selectPurchaseVo"/>
        <where>
            <if test="purchaseNo != null and purchaseNo != ''"> AND t.purchase_no = #{purchaseNo}</if>
            <if test="supplierId != null"> AND t.supplier_id = #{supplierId}</if>
            <if test="status != null and status != ''"> AND t.status = #{status}</if>
        </where>
        order by t.purchase_id desc
    </select>

    <select id="selectPurchaseByPurchaseId" parameterType="Long" resultMap="PurchaseResult">
        <include refid="selectPurchaseVo"/>
        where t.purchase_id = #{purchaseId}
    </select>

    <insert id="insertPurchase" parameterType="com.ruoyi.his.domain.Purchase" useGeneratedKeys="true" keyProperty="purchaseId">
        insert into his_purchase
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="purchaseNo != null and purchaseNo != ''">purchase_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="inTime != null">in_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="purchaseNo != null and purchaseNo != ''">#{purchaseNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="inTime != null">#{inTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePurchase" parameterType="com.ruoyi.his.domain.Purchase">
        update his_purchase
        <trim prefix="SET" suffixOverrides=",">
            <if test="purchaseNo != null and purchaseNo != ''">purchase_no = #{purchaseNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="inTime != null">in_time = #{inTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where purchase_id = #{purchaseId}
    </update>

    <delete id="deletePurchaseByPurchaseId" parameterType="Long">
        delete from his_purchase where purchase_id = #{purchaseId}
    </delete>

    <delete id="deletePurchaseByPurchaseIds" parameterType="String">
        delete from his_purchase where purchase_id in
        <foreach item="purchaseId" collection="array" open="(" separator="," close=")">
            #{purchaseId}
        </foreach>
    </delete>
</mapper>
