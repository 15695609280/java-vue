<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.LabTestMapper">

    <resultMap type="LabTest" id="LabTestResult">
        <id property="testId" column="test_id" />
        <result property="testNo" column="test_no" />
        <result property="patientId" column="patient_id" />
        <result property="patientName" column="patient_name" />
        <result property="gender" column="gender" />
        <result property="age" column="age" />
        <result property="visitId" column="visit_id" />
        <result property="admId" column="adm_id" />
        <result property="doctorId" column="doctor_id" />
        <result property="doctorName" column="doctor_name" />
        <result property="testItem" column="test_item" />
        <result property="sampleType" column="sample_type" />
        <result property="status" column="status" />
        <result property="applyTime" column="apply_time" />
        <result property="sampleTime" column="sample_time" />
        <result property="reportTime" column="report_time" />
        <result property="resultSummary" column="result_summary" />
        <result property="reportBy" column="report_by" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectLabTestVo">
        select t.test_id, t.test_no, t.patient_id, t.visit_id, t.adm_id, t.doctor_id, t.test_item, t.sample_type, t.status, t.apply_time, t.sample_time, t.report_time, t.result_summary, t.report_by, p.patient_name, p.gender, p.age, doc.doctor_name
        from his_lab_test t
        left join his_patient p on p.patient_id = t.patient_id
        left join his_doctor doc on doc.doctor_id = t.doctor_id
    </sql>

    <select id="selectLabTestList" parameterType="com.ruoyi.his.domain.LabTest" resultMap="LabTestResult">
        <include refid="selectLabTestVo"/>
        <where>
            <if test="testNo != null and testNo != ''"> AND t.test_no = #{testNo}</if>
            <if test="patientId != null"> AND t.patient_id = #{patientId}</if>
            <if test="testItem != null and testItem != ''"> AND t.test_item like concat('%', #{testItem}, '%')</if>
            <if test="status != null and status != ''"> AND t.status = #{status}</if>
        </where>
        order by t.test_id desc
    </select>

    <select id="selectLabTestByTestId" parameterType="Long" resultMap="LabTestResult">
        <include refid="selectLabTestVo"/>
        where t.test_id = #{testId}
    </select>

    <insert id="insertLabTest" parameterType="com.ruoyi.his.domain.LabTest" useGeneratedKeys="true" keyProperty="testId">
        insert into his_lab_test
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="testNo != null and testNo != ''">test_no,</if>
            <if test="patientId != null">patient_id,</if>
            <if test="visitId != null">visit_id,</if>
            <if test="admId != null">adm_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="testItem != null and testItem != ''">test_item,</if>
            <if test="sampleType != null and sampleType != ''">sample_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="applyTime != null">apply_time,</if>
            <if test="sampleTime != null">sample_time,</if>
            <if test="reportTime != null">report_time,</if>
            <if test="resultSummary != null and resultSummary != ''">result_summary,</if>
            <if test="reportBy != null and reportBy != ''">report_by,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="testNo != null and testNo != ''">#{testNo},</if>
            <if test="patientId != null">#{patientId},</if>
            <if test="visitId != null">#{visitId},</if>
            <if test="admId != null">#{admId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="testItem != null and testItem != ''">#{testItem},</if>
            <if test="sampleType != null and sampleType != ''">#{sampleType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="applyTime != null">#{applyTime},</if>
            <if test="sampleTime != null">#{sampleTime},</if>
            <if test="reportTime != null">#{reportTime},</if>
            <if test="resultSummary != null and resultSummary != ''">#{resultSummary},</if>
            <if test="reportBy != null and reportBy != ''">#{reportBy},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateLabTest" parameterType="com.ruoyi.his.domain.LabTest">
        update his_lab_test
        <trim prefix="SET" suffixOverrides=",">
            <if test="testNo != null and testNo != ''">test_no = #{testNo},</if>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="visitId != null">visit_id = #{visitId},</if>
            <if test="admId != null">adm_id = #{admId},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="testItem != null and testItem != ''">test_item = #{testItem},</if>
            <if test="sampleType != null and sampleType != ''">sample_type = #{sampleType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="applyTime != null">apply_time = #{applyTime},</if>
            <if test="sampleTime != null">sample_time = #{sampleTime},</if>
            <if test="reportTime != null">report_time = #{reportTime},</if>
            <if test="resultSummary != null and resultSummary != ''">result_summary = #{resultSummary},</if>
            <if test="reportBy != null and reportBy != ''">report_by = #{reportBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where test_id = #{testId}
    </update>

    <delete id="deleteLabTestByTestId" parameterType="Long">
        delete from his_lab_test where test_id = #{testId}
    </delete>

    <delete id="deleteLabTestByTestIds" parameterType="String">
        delete from his_lab_test where test_id in
        <foreach item="testId" collection="array" open="(" separator="," close=")">
            #{testId}
        </foreach>
    </delete>

    <update id="updateStatus">
        update his_lab_test
        <set>
            status = #{status},
            <if test="status == '1'">sample_time = now(),</if>
        </set>
        where test_id = #{testId}
    </update>
</mapper>
