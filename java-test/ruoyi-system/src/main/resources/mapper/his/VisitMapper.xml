<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.VisitMapper">

    <resultMap type="Visit" id="VisitResult">
        <id property="visitId" column="visit_id" />
        <result property="visitNo" column="visit_no" />
        <result property="regId" column="reg_id" />
        <result property="patientId" column="patient_id" />
        <result property="patientName" column="patient_name" />
        <result property="doctorId" column="doctor_id" />
        <result property="doctorName" column="doctor_name" />
        <result property="deptId" column="dept_id" />
        <result property="deptName" column="dept_name" />
        <result property="visitTime" column="visit_time" />
        <result property="chiefComplaint" column="chief_complaint" />
        <result property="presentIllness" column="present_illness" />
        <result property="pastIllness" column="past_illness" />
        <result property="diagnosis" column="diagnosis" />
        <result property="treatment" column="treatment" />
        <result property="status" column="status" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectVisitVo">
        select t.visit_id, t.visit_no, t.reg_id, t.patient_id, t.doctor_id, t.dept_id, t.visit_time, t.chief_complaint, t.present_illness, t.past_illness, t.diagnosis, t.treatment, t.status, p.patient_name, doc.doctor_name, d.dept_name
        from his_visit t
        left join his_patient p on p.patient_id = t.patient_id
        left join his_department d on d.dept_id = t.dept_id
        left join his_doctor doc on doc.doctor_id = t.doctor_id
    </sql>

    <select id="selectVisitList" parameterType="com.ruoyi.his.domain.Visit" resultMap="VisitResult">
        <include refid="selectVisitVo"/>
        <where>
            <if test="visitNo != null and visitNo != ''"> AND t.visit_no = #{visitNo}</if>
            <if test="regId != null"> AND t.reg_id = #{regId}</if>
            <if test="patientId != null"> AND t.patient_id = #{patientId}</if>
            <if test="doctorId != null"> AND t.doctor_id = #{doctorId}</if>
        </where>
        order by t.visit_id desc
    </select>

    <select id="selectVisitByVisitId" parameterType="Long" resultMap="VisitResult">
        <include refid="selectVisitVo"/>
        where t.visit_id = #{visitId}
    </select>

    <insert id="insertVisit" parameterType="com.ruoyi.his.domain.Visit" useGeneratedKeys="true" keyProperty="visitId">
        insert into his_visit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="visitNo != null and visitNo != ''">visit_no,</if>
            <if test="regId != null">reg_id,</if>
            <if test="patientId != null">patient_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="visitTime != null">visit_time,</if>
            <if test="chiefComplaint != null and chiefComplaint != ''">chief_complaint,</if>
            <if test="presentIllness != null and presentIllness != ''">present_illness,</if>
            <if test="pastIllness != null and pastIllness != ''">past_illness,</if>
            <if test="diagnosis != null and diagnosis != ''">diagnosis,</if>
            <if test="treatment != null and treatment != ''">treatment,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="visitNo != null and visitNo != ''">#{visitNo},</if>
            <if test="regId != null">#{regId},</if>
            <if test="patientId != null">#{patientId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="visitTime != null">#{visitTime},</if>
            <if test="chiefComplaint != null and chiefComplaint != ''">#{chiefComplaint},</if>
            <if test="presentIllness != null and presentIllness != ''">#{presentIllness},</if>
            <if test="pastIllness != null and pastIllness != ''">#{pastIllness},</if>
            <if test="diagnosis != null and diagnosis != ''">#{diagnosis},</if>
            <if test="treatment != null and treatment != ''">#{treatment},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateVisit" parameterType="com.ruoyi.his.domain.Visit">
        update his_visit
        <trim prefix="SET" suffixOverrides=",">
            <if test="visitNo != null and visitNo != ''">visit_no = #{visitNo},</if>
            <if test="regId != null">reg_id = #{regId},</if>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="visitTime != null">visit_time = #{visitTime},</if>
            <if test="chiefComplaint != null and chiefComplaint != ''">chief_complaint = #{chiefComplaint},</if>
            <if test="presentIllness != null and presentIllness != ''">present_illness = #{presentIllness},</if>
            <if test="pastIllness != null and pastIllness != ''">past_illness = #{pastIllness},</if>
            <if test="diagnosis != null and diagnosis != ''">diagnosis = #{diagnosis},</if>
            <if test="treatment != null and treatment != ''">treatment = #{treatment},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where visit_id = #{visitId}
    </update>

    <delete id="deleteVisitByVisitId" parameterType="Long">
        delete from his_visit where visit_id = #{visitId}
    </delete>

    <delete id="deleteVisitByVisitIds" parameterType="String">
        delete from his_visit where visit_id in
        <foreach item="visitId" collection="array" open="(" separator="," close=")">
            #{visitId}
        </foreach>
    </delete>
</mapper>
