<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.WardMapper">

    <resultMap type="Ward" id="WardResult">
        <id property="wardId" column="ward_id" />
        <result property="wardName" column="ward_name" />
        <result property="deptId" column="dept_id" />
        <result property="deptName" column="dept_name" />
        <result property="location" column="location" />
        <result property="nurseCount" column="nurse_count" />
        <result property="status" column="status" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectWardVo">
        select t.ward_id, t.ward_name, t.dept_id, t.location, t.nurse_count, t.status, d.dept_name
        from his_ward t
        left join his_department d on d.dept_id = t.dept_id
    </sql>

    <select id="selectWardList" parameterType="com.ruoyi.his.domain.Ward" resultMap="WardResult">
        <include refid="selectWardVo"/>
        <where>
            <if test="wardName != null and wardName != ''"> AND t.ward_name like concat('%', #{wardName}, '%')</if>
        </where>
        order by t.ward_id
    </select>

    <select id="selectWardByWardId" parameterType="Long" resultMap="WardResult">
        <include refid="selectWardVo"/>
        where t.ward_id = #{wardId}
    </select>

    <insert id="insertWard" parameterType="com.ruoyi.his.domain.Ward" useGeneratedKeys="true" keyProperty="wardId">
        insert into his_ward
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="wardName != null and wardName != ''">ward_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="nurseCount != null">nurse_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="wardName != null and wardName != ''">#{wardName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="nurseCount != null">#{nurseCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateWard" parameterType="com.ruoyi.his.domain.Ward">
        update his_ward
        <trim prefix="SET" suffixOverrides=",">
            <if test="wardName != null and wardName != ''">ward_name = #{wardName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="nurseCount != null">nurse_count = #{nurseCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where ward_id = #{wardId}
    </update>

    <delete id="deleteWardByWardId" parameterType="Long">
        delete from his_ward where ward_id = #{wardId}
    </delete>

    <delete id="deleteWardByWardIds" parameterType="String">
        delete from his_ward where ward_id in
        <foreach item="wardId" collection="array" open="(" separator="," close=")">
            #{wardId}
        </foreach>
    </delete>
</mapper>
