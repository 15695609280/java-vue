<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.his.mapper.PrescriptionMapper">

    <resultMap type="Prescription" id="PrescriptionResult">
        <id property="rxId" column="rx_id" />
        <result property="rxNo" column="rx_no" />
        <result property="visitId" column="visit_id" />
        <result property="patientId" column="patient_id" />
        <result property="patientName" column="patient_name" />
        <result property="doctorId" column="doctor_id" />
        <result property="doctorName" column="doctor_name" />
        <result property="rxType" column="rx_type" />
        <result property="totalAmount" column="total_amount" />
        <result property="status" column="status" />
        <result property="dispenseBy" column="dispense_by" />
        <result property="dispenseTime" column="dispense_time" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectPrescriptionVo">
        select t.rx_id, t.rx_no, t.visit_id, t.patient_id, t.doctor_id, t.rx_type, t.total_amount, t.status, t.dispense_by, t.dispense_time, p.patient_name, doc.doctor_name
        from his_prescription t
        left join his_patient p on p.patient_id = t.patient_id
        left join his_doctor doc on doc.doctor_id = t.doctor_id
    </sql>

    <select id="selectPrescriptionList" parameterType="com.ruoyi.his.domain.Prescription" resultMap="PrescriptionResult">
        <include refid="selectPrescriptionVo"/>
        <where>
            <if test="rxNo != null and rxNo != ''"> AND t.rx_no = #{rxNo}</if>
            <if test="patientId != null"> AND t.patient_id = #{patientId}</if>
            <if test="status != null and status != ''"> AND t.status = #{status}</if>
        </where>
        order by t.rx_id desc
    </select>

    <select id="selectPrescriptionByRxId" parameterType="Long" resultMap="PrescriptionResult">
        <include refid="selectPrescriptionVo"/>
        where t.rx_id = #{rxId}
    </select>

    <insert id="insertPrescription" parameterType="com.ruoyi.his.domain.Prescription" useGeneratedKeys="true" keyProperty="rxId">
        insert into his_prescription
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="rxNo != null and rxNo != ''">rx_no,</if>
            <if test="visitId != null">visit_id,</if>
            <if test="patientId != null">patient_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="rxType != null and rxType != ''">rx_type,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="dispenseBy != null and dispenseBy != ''">dispense_by,</if>
            <if test="dispenseTime != null">dispense_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="rxNo != null and rxNo != ''">#{rxNo},</if>
            <if test="visitId != null">#{visitId},</if>
            <if test="patientId != null">#{patientId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="rxType != null and rxType != ''">#{rxType},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="dispenseBy != null and dispenseBy != ''">#{dispenseBy},</if>
            <if test="dispenseTime != null">#{dispenseTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePrescription" parameterType="com.ruoyi.his.domain.Prescription">
        update his_prescription
        <trim prefix="SET" suffixOverrides=",">
            <if test="rxNo != null and rxNo != ''">rx_no = #{rxNo},</if>
            <if test="visitId != null">visit_id = #{visitId},</if>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="rxType != null and rxType != ''">rx_type = #{rxType},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="dispenseBy != null and dispenseBy != ''">dispense_by = #{dispenseBy},</if>
            <if test="dispenseTime != null">dispense_time = #{dispenseTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where rx_id = #{rxId}
    </update>

    <delete id="deletePrescriptionByRxId" parameterType="Long">
        delete from his_prescription where rx_id = #{rxId}
    </delete>

    <delete id="deletePrescriptionByRxIds" parameterType="String">
        delete from his_prescription where rx_id in
        <foreach item="rxId" collection="array" open="(" separator="," close=")">
            #{rxId}
        </foreach>
    </delete>

    <update id="updateStatus">
        update his_prescription set status = #{status} where rx_id = #{rxId}
    </update>
</mapper>
