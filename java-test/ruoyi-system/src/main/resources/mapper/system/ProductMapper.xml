<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ProductMapper">

    <!--
      【练习目标】掌握 MyBatis XML 编写
      - namespace 必须与 Mapper 接口全限定名一致
      - resultMap 做字段映射（数据库列名 vs Java属性名）
      - select/insert/update/delete 的 id 必须与接口方法名一致
      - #{} 预编译（防SQL注入），${} 字符串拼接（慎用）
      - <where> <if> 动态SQL
      - <foreach> 批量操作

      【对着敲练习】参考 mapper/system/SysPostMapper.xml
    -->

    <resultMap type="com.ruoyi.system.domain.Product" id="ProductResult">
        <id     property="productId"   column="product_id"   />
        <result property="productName" column="product_name" />
        <result property="price"       column="price"        />
        <result property="stock"       column="stock"        />
        <result property="status"      column="status"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <!-- 查询商品列表 -->
    <select id="selectProductList" parameterType="com.ruoyi.system.domain.Product" resultMap="ProductResult">
        select product_id, product_name, price, stock, status, create_by, create_time, update_by, update_time, remark
        from product
        <where>
            <if test="productName != null and productName != ''"> AND product_name like concat('%', #{productName}, '%')</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
        </where>
        order by product_id desc
    </select>

    <!-- 查询商品 -->
    <select id="selectProductById" parameterType="Long" resultMap="ProductResult">
        select product_id, product_name, price, stock, status, create_by, create_time, update_by, update_time, remark
        from product
        where product_id = #{productId}
    </select>

    <!-- 新增商品 -->
    <insert id="insertProduct" parameterType="com.ruoyi.system.domain.Product" useGeneratedKeys="true" keyProperty="productId">
        insert into product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="price != null">price,</if>
            <if test="stock != null">stock,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="price != null">#{price},</if>
            <if test="stock != null">#{stock},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <!-- 修改商品 -->
    <update id="updateProduct" parameterType="com.ruoyi.system.domain.Product">
        update product
        <trim prefix="SET" suffixOverrides=",">
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where product_id = #{productId}
    </update>

    <!-- 删除商品 -->
    <delete id="deleteProductById" parameterType="Long">
        delete from product where product_id = #{productId}
    </delete>

    <!-- 批量删除商品 -->
    <delete id="deleteProductByIds" parameterType="String">
        delete from product where product_id in
        <foreach item="productId" collection="array" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </delete>

</mapper>
