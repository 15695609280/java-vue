<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  若依管理系统（RuoYi-Vue，Spring Boot 3 版）—— 父工程 POM
  ============================================================================
  本文件是整个后端工程的"总控中心"，只做三件事，一行业务代码都没有：
    1. 模块聚合：通过 <modules> 把 6 个子模块聚合成"一次命令构建全部"。
    2. 版本管家：通过 <properties> + <dependencyManagement> 集中锁定所有第三方库版本，
       子模块引用时无需写 <version>；升级只改本文件一处。
    3. 构建约定：统一 Java 版本（17）、源码编码（UTF-8）、编译器参数与依赖仓库地址。

  【模块依赖关系图】（箭头含义：A → B 表示 A 依赖 B，构建时 B 必须先构建）
      ruoyi-admin（启动模块，jar）
        ├── ruoyi-framework
        │     └── ruoyi-system
        │           └── ruoyi-common
        ├── ruoyi-quartz
        │     └── ruoyi-common
        └── ruoyi-generator
              └── ruoyi-common
      结论：ruoyi-common 是最底层的被依赖方，改它会导致几乎所有模块重编。

  【重要】packaging = pom —— 本工程不产出 jar/war，只做管理与聚合。
          若误改成 jar，会被打成一个空包，并导致子模块继承/版本解析异常。

  【Maven 三个坐标（GAV）】groupId + artifactId + version 是仓库中定位构件的唯一地址，
  子模块用 <parent> 引用这三个值来继承本 POM 的全部配置。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven 项目模型版本。Maven 2 之后固定为 4.0.0，是 pom 的"格式版本"，不是项目版本，永不修改 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== 一、项目基本信息（GAV 坐标） ==================== -->

    <!-- groupId：组织/公司的唯一标识，约定用「反向域名」，com.ruoyi 对应官网 ruoyi.vip。
         它也决定了构件在本地仓库的存放路径：~/.m2/repository/com/ruoyi/... -->
    <groupId>com.ruoyi</groupId>

    <!-- artifactId：项目/模块的唯一标识，即项目名。同一 groupId 下不可重复 -->
    <artifactId>ruoyi</artifactId>

    <!-- version：当前版本号。3.9.2 是若依的发布版本。
         子模块通过 ${ruoyi.version} 引用同一版本号 —— 注意这里刻意没有用内置的 ${project.version}，
         原因：子模块自己的 project.version 就是各自模块的版本，用 ${ruoyi.version} 更直观、不产生歧义 -->
    <version>3.9.2</version>

    <!-- name：项目显示名称，只出现在日志/IDE 里，不参与坐标定位 -->
    <name>ruoyi</name>
    <!-- url：项目官网，纯元信息 -->
    <url>http://www.ruoyi.vip</url>
    <!-- description：项目描述，纯元信息 -->
    <description>若依管理系统</description>

    <!-- ==================== 二、properties：全局属性（版本号集中管理） ==================== -->
    <!--
      【作用】这里每个子标签都是一个"变量"，其他任何位置都能用 ${标签名} 取值。
      为什么必须集中放这里？
        · 升级某个库时只改一行，不必翻遍 6 个子模块的 pom；
        · 杜绝不同子模块引用同一库的不同版本 —— 那会导致运行时 NoSuchMethodError /
          ClassNotFoundException 这类"编译通过、启动报错"的隐蔽故障。
      【取值时机】Maven 在解析 pom 时做的是文本级替换，子模块继承父工程 properties 后，
        同样能读到这些变量，所以子模块里也能写 ${java.version}。

      下面两个以 project. 开头的是 Maven 内置属性名，属于"覆盖内置默认值"的写法，
      改完对整个工程（含所有子模块的报告输出）生效，不是自定义变量。
    -->
    <properties>
        <!-- ── 编码与 JDK ────────────────────────────────────────────── -->

        <!-- 【Maven 内置属性】源码文件编码。不设或设错，中文注释/字符串编译后必乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 【Maven 内置属性】构建报告（如 surefire 测试报告、javadoc）的输出编码 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JDK 编译版本。Spring Boot 3.x 硬性要求 Java 17 起（2.x 时代是 8），
             这是若依"SpringBoot3 分支"与旧分支的最大区别之一。低于 17 会直接编译失败 -->
        <java.version>17</java.version>

        <!-- ── 核心框架 ──────────────────────────────────────────────── -->

        <!-- 若依自身 6 个子模块的版本号，须与上方 <version> 保持一致 -->
        <ruoyi.version>3.9.2</ruoyi.version>
        <!-- Spring Boot 框架版本。3.x 的三大分水岭：
             ① 最低 Java 17；② javax.* 全部迁移为 jakarta.*；③ 内嵌容器与配置项大改。
             所以「Spring Boot 2.x 的若依」和「3.x 的若依」代码不能直接互抄 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- MyBatis 官方提供的 Spring Boot 整合启动器版本。
             注意它【不在】 Spring Boot BOM 的管辖范围内，属于第三方，所以必须在此显式声明版本 -->
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>

        <!-- ── 数据访问与缓存 ────────────────────────────────────────── -->

        <!-- 阿里巴巴 Druid 数据库连接池。除连接池本身，还自带 SQL 监控面板 /druid/index.html，
             可查看慢 SQL、执行次数、连接活跃数 —— 若依"数据监控"页面依赖它 -->
        <druid.version>1.2.28</druid.version>
        <!-- PageHelper：MyBatis 物理分页插件（Spring Boot 启动器形态）。
             它同样不在 Spring Boot BOM 里，需显式声明版本 -->
        <pagehelper.boot.version>2.1.1</pagehelper.boot.version>

        <!-- ── 业务支撑工具 ──────────────────────────────────────────── -->

        <!-- Yauaa：解析 HTTP 请求头中的 User-Agent，识别客户端操作系统/浏览器/设备型号。
             驱动"系统监控 - 登录日志"和"在线用户"列表里的客户端信息列。
             名字来源：Yet Another UserAgent Analyzer -->
        <yauaa.version>8.2.0</yauaa.version>
        <!-- Kaptcha：Google 的图形验证码生成库。若依用的是 pro.fessional 维护的兼容分支
             （groupId 为 pro.fessional 而非 google 官方），主要用于登录/注册页的验证码图片 -->
        <kaptcha.version>2.3.3</kaptcha.version>
        <!-- 阿里巴巴 Fastjson2：Fastjson 1.x 的重写升级版，主打性能与安全修复
             （1.x 曾多次爆出反序列化远程代码执行漏洞）。若依用它处理部分 JSON 与 Redis 值序列化 -->
        <fastjson.version>2.0.64</fastjson.version>
        <!-- OSHI：跨平台（Windows/Linux/macOS）读取硬件信息 —— CPU、内存、磁盘、网络、JVM。
             驱动"系统监控 - 服务器信息"页面。
             名字来源：Operating System and Hardware Information -->
        <oshi.version>7.4.4</oshi.version>
        <!-- Apache Commons IO：封装文件读写、目录遍历、流拷贝、文件比较等操作，消除样板代码 -->
        <commons.io.version>2.22.0</commons.io.version>
        <!-- Apache POI：读写 Office 文件。这里用的是 poi-ooxml 子模块（处理 .xlsx），
             .xls 老格式则由 poi 本体处理。若依所有"Excel 导入/导出"功能底层都是它 -->
        <poi.version>5.5.1</poi.version>
        <!-- Apache Velocity：模板引擎。代码生成器读取 resources/vm 下的 .vm 模板文件，
             注入数据库表结构数据后渲染出 Entity/Mapper/Service/Controller/Vue 等源码文件 -->
        <velocity.version>2.3</velocity.version>
        <!-- JJWT：生成与解析 JWT。0.9.1 属于旧版单包 API，
             新版 0.11+ 已拆分为 jjwt-api / jjwt-impl / jjwt-jackson 三个构件，
             故升级此版本号时需同步修改子模块的依赖坐标，不能只改版本 -->
        <jwt.version>0.9.1</jwt.version>
        <!-- JAXB API：Java 对象与 XML 互转的标准 API。Java 11 起已从 JDK 中移除
             （JEP 320），部分第三方库内部仍调用它，缺失会抛
             ClassNotFoundException: javax.xml.bind.DatatypeConverter -->
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <!-- Springdoc OpenAPI：扫描 Controller 自动生成在线接口文档（Swagger UI）。
             它是 springfox 停止维护后的主流替代方案，且 2.x 才支持 Spring Boot 3 -->
        <springdoc.version>2.9.0</springdoc.version>
    </properties>

    <!-- ==================== 三、dependencyManagement：依赖版本声明 ==================== -->
    <!--
      【必须先分清这两个标签，否则极易踩坑】
        <dependencies>          = 真引入：会下载 jar、进入编译与运行类路径。
                                  写在父工程里会被所有子模块【无条件】继承。
        <dependencyManagement>  = 只登记：不下载、不进类路径。
                                  子模块要用某依赖时仍需自己写 <dependency>，
                                  但可以省略 <version> —— 版本自动由此处提供。

      好处：① 版本集中管控，多模块不会打架；② 子模块按需引入，避免无关依赖污染。

      【版本决定优先级】子模块显式写的 <version> > 父工程 dependencyManagement
        > 依赖传递来的版本（遵循"路径最近者优先，同深度则先声明者优先"）。
        也就是说，一旦某个子模块自己写了版本号，这里的管控对它就失效了。

      【本工程为何 6 个模块都不写版本】它们全部靠本节的 BOM + 显式声明来定版本。
      注意：本节条目的书写顺序不影响结果（Maven 内部有固定解析逻辑）。
    -->
    <dependencyManagement>
        <dependencies>

            <!-- ▼ Spring Boot 官方依赖总集（BOM = Bill of Materials，"物料清单"）
                 · type=pom    → 引入的是一个 pom 文件，而非 jar
                 · scope=import → dependencyManagement 中独有的作用域，
                                  语义是"把该 BOM 内声明的所有版本原样并入本工程的管控列表"
                 效果：子模块写 spring-boot-starter-web / -security / -data-redis /
                 -validation / devtools / mysql-connector-j / flyway 等时，一律无需写版本号。
                 这是整个工程版本管理的"地基"，应当放在最前面。 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ▼ 阿里巴巴 Druid 数据库连接池启动器。
                 artifactId 里的 "3" 表示适配 Spring Boot 3 / jakarta 命名空间，
                 用错（写成 druid-spring-boot-starter）会在启动时报 jakarta.servlet 相关错误 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ▼ Yauaa：User-Agent 解析器，供"登录日志""在线用户"展示客户端信息 -->
            <dependency>
                <groupId>nl.basjes.parse.useragent</groupId>
                <artifactId>yauaa</artifactId>
                <version>${yauaa.version}</version>
            </dependency>

            <!-- ▼ PageHelper：MyBatis 物理分页插件。
                 代码里 PageHelper.startPage(pageNum, pageSize) 之后，插件通过 MyBatis 拦截器
                 捕获"紧随其后的那一条查询"并自动改写 SQL 追加 limit，
                 因此 startPage 必须紧贴目标查询语句，中间不能隔其他查询 -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.boot.version}</version>
            </dependency>

            <!-- ▼ MyBatis 与 Spring Boot 整合启动器：自动装配 SqlSessionFactory / SqlSessionTemplate，
                 支持 @Mapper 扫描与 XML 映射文件加载。这也是若依 Mapper 接口无需写实现类的原因 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- ▼ JAXB API：Java 11 移除后的补偿依赖（见上方 properties 中说明）。
                 缺它时常见于导入导出、报表等调用 XML 绑定的路径 -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>

            <!-- ▼ OSHI：跨平台采集硬件与系统指标，是"服务器监控"页面的唯一数据来源 -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- ▼ Springdoc OpenAPI：自动扫描 Controller 生成 Swagger 在线接口文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ▼ Apache Commons IO：文件与流的常用操作工具类 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>

            <!-- ▼ Apache POI OOXML：操作 .xlsx 格式 Excel（.xls 用 poi 本体，.xlsx 用 poi-ooxml）
                 若依封装的 ExcelUtil 在此基础上提供注解式导入导出 -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- ▼ Velocity 模板引擎核心：代码生成器的渲染引擎，
                     模板与表结构数据结合后产出前后端源码 -->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.version}</version>
            </dependency>

            <!-- ▼ Fastjson2：JSON 序列化/反序列化，用于部分工具类与 Redis 缓存值转换 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson.version}</version>
            </dependency>

            <!-- ▼ JJWT：登录成功后签发 Token，前端保存后在每次请求头中携带，
                     由过滤器校验 —— 属无状态认证，服务端不维护 Session -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!-- ▼ Kaptcha：登录页图形验证码的生成器，字体/颜色/干扰线/长度均可配置 -->
            <dependency>
                <groupId>pro.fessional</groupId>
                <artifactId>kaptcha</artifactId>
                <version>${kaptcha.version}</version>
            </dependency>

            <!-- ══════════════ 以下为若依自研子模块 ══════════════
                 同样在此统一版本，模块间互相引用时无需写 <version>。
                 这也保证了「六个模块永远同版本」，不会出现 framework 3.9.2 配 system 3.9.1 的情况 -->

            <!-- 定时任务模块：基于 Quartz 的可视化任务管理
                 （新增/修改/删除、立即执行一次、暂停恢复、执行日志查看） -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-quartz</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 代码生成模块：读取数据库表结构，一键生成前后端 CRUD 代码
                 （Entity / Mapper / XML / Service / Controller / Vue 页面 / API 脚本） -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-generator</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 框架核心模块：Spring Security 配置、JWT 认证过滤器、多数据源、Redis 缓存、
                 全局异常处理、AOP 日志与限流等基础设施 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-framework</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 系统业务模块：用户 / 角色 / 菜单 / 部门 / 岗位 / 字典 / 参数 / 通知公告等核心业务 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-system</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 通用工具模块：字符串、日期、文件、加密、Excel、树结构等公共工具类与常量、注解。
                 处于依赖链最底层，几乎所有模块都依赖它 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-common</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ==================== 四、modules：子模块聚合 ==================== -->
    <!--
      【构建机制】执行 mvn install / package 时，Maven 会：
        1. 读取每个子模块的 <parent> 指向，据此构建模块依赖图（DAG）；
        2. 按拓扑顺序构建 —— 被依赖的先构建，所以【此处书写顺序不影响构建顺序】；
        3. 各模块产物直接进入本次构建的 reactor 上下文，无需先装进本地仓库即可被下游模块使用。
      所以下面的顺序只是为了可读性（启动模块排最前，符合阅读习惯），并非构建依据。
    -->
    <modules>
        <module>ruoyi-admin</module>       <!-- 启动模块：RuoYiApplication 启动类、application.yml、全部 Controller 入口 -->
        <module>ruoyi-framework</module>   <!-- 框架核心：Security、JWT 过滤器、多数据源、Redis、全局异常处理 -->
        <module>ruoyi-system</module>      <!-- 系统业务：用户/角色/菜单/部门/字典等（框架层认证逻辑依赖它） -->
        <module>ruoyi-quartz</module>      <!-- 定时任务：Quartz 可视化调度 -->
        <module>ruoyi-generator</module>   <!-- 代码生成：读表结构产出前后端代码 -->
        <module>ruoyi-common</module>      <!-- 通用工具：公共工具类、常量、注解、异常基类 -->
    </modules>

    <!-- packaging=pom：声明本工程为"聚合工程 / 父工程"，只做版本管理与模块聚合，不产出 jar/war。
         若误写为 jar，会打出一个空包，且子模块继承时可能因解析到错误构件而构建失败 -->
    <packaging>pom</packaging>

    <!-- ==================== 五、build：构建配置 ==================== -->
    <!--
      父工程 build 里声明的插件会被所有子模块继承（包括版本号）。
      【插件 vs 依赖的区别】依赖是"编译/运行期使用的库"；插件是"构建过程中执行的一段任务"
      （编译、打包、测试、生成代码等）。二者仓库配置也互相独立，见第六、七节。

      本节的另一个作用是：子模块声明插件时可省略 <version>，统一由这里锁定。
      例如 ruoyi-admin 里写 spring-boot-maven-plugin 时不写版本号，正是继承自此处。
    -->
    <build>
        <plugins>

            <!-- ▼ Maven 编译插件：控制 javac 行为，Java 工程最核心的构建插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- parameters=true：编译时加 -parameters，把方法形参名保留进字节码。
                         Spring MVC 的 @RequestParam / @PathVariable 在未指定 value 时【按参数名绑定】，
                         缺少此项会在运行时报：
                         "Name for argument of type [java.lang.String] not specified" -->
                    <parameters>true</parameters>

                    <!-- useIncrementalCompilation=false：关闭增量编译，每次全量重编。
                         目的：IDE 自动编译往 target/classes 写入的 class 时间戳较新时，
                         Maven 会误判"已是最新"而跳过编译，导致改了代码却不生效。
                         关掉它等于牺牲一点编译速度换取"结果一定是最新的" -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>

                    <!-- source：源码语法版本，取自 properties 中的 java.version（17） -->
                    <source>${java.version}</source>
                    <!-- target：目标字节码版本，须与 source 一致，避免高低版本不匹配 -->
                    <target>${java.version}</target>
                    <!-- encoding：读取源码文件所用字符集，防止中文乱码 -->
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- ▼ Spring Boot Maven 插件：提供 spring-boot:run（免打包直接启动）、
                 spring-boot:repackage（把普通 jar 重打成含内嵌 Tomcat 的可执行 jar）等能力。
                 此处的作用是【统一版本 + 供子模块继承】：真正配置该插件的是 ruoyi-admin，
                 它在自己的 build 里声明了同样的坐标（不写版本号，继承此处）并绑定 repackage 目标 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>

        </plugins>
    </build>

    <!-- ==================== 六、repositories：依赖（jar 包）下载仓库 ==================== -->
    <!--
      【为什么需要配】Maven 默认从国外中央仓库下载，国内访问慢且易超时。
      阿里云公共仓库聚合了中央仓库、Google、JCenter 等源，速度显著提升。

      【查找顺序】先在 settings.xml 的 <mirrors> 中做镜像匹配，
        再按此处 <repositories> 的声明顺序尝试；任一下载成功即缓存到本地仓库
        （Windows 通常在 C:\Users\<用户名>\.m2\repository），后续构建不再联网。

      【更推荐的做法】把镜像配在 ~/.m2/settings.xml 的 <mirror> 中，全局生效；
      此处写进 pom 的好处是「换台机器/同事拉下代码即可用」，缺点是无法覆盖已有 mirror 配置。
    -->
    <repositories>
        <repository>
            <!-- id：仓库唯一标识，用于与 settings.xml 中的 mirror 做匹配、以及在日志中区分来源。
                 若本地 mirror 也用 id=public，会直接接管此仓库的请求 -->
            <id>public</id>
            <!-- name：仓库描述名，仅供人阅读 -->
            <name>aliyun nexus</name>
            <!-- url：仓库实际地址 -->
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <!-- 允许下载正式版（release）依赖 -->
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <!-- ==================== 七、pluginRepositories：插件下载仓库 ==================== -->
    <!--
      【为什么要再配一遍】Maven 中"插件"与"普通依赖"走两套彼此独立的仓库配置，
      只配第六节的话，maven-compiler-plugin、spring-boot-maven-plugin 等仍会去国外中央仓库拉取，
      依赖下载很快但插件卡住 —— 这是常见的"下载慢"错觉来源。
      故此处同样指向阿里云镜像。

      本节的快照策略比第六节更严格：显式禁止 snapshot 插件，因为快照版内容可变、
      同一版本号在不同时间可能拉到不同产物，会破坏构建的可复现性。
    -->
    <pluginRepositories>
        <pluginRepository>
            <!-- 仓库唯一标识 -->
            <id>public</id>
            <!-- 仓库描述名 -->
            <name>aliyun nexus</name>
            <!-- 阿里云公共仓库地址，与第六节一致 -->
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <!-- 允许下载正式版插件 -->
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <!-- 禁止下载快照版（snapshot）插件，保证构建稳定性与可复现 -->
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!--
  ============================================================================
  附：常用命令速查
  ----------------------------------------------------------------------------
    mvn clean install -DskipTests     全量构建并装入本地仓库（跳过测试，日常最常用）
    mvn clean package -pl ruoyi-admin -am
                                      只打启动模块及其依赖（-am = also make），大幅缩短构建时间
    mvn spring-boot:run -pl ruoyi-admin
                                      免打包直接启动（等价于在 ruoyi-admin 目录下运行）
    mvn dependency:tree -Dincludes=com.alibaba
                                      查看某依赖的传递路径，排查"版本冲突/重复引入"
    mvn help:effective-pom -pl ruoyi-common
                                      输出合并父工程后的"最终生效 pom"，验证版本继承是否符合预期
    mvn -U clean install              强制更新快照依赖（-U = update snapshots）
    mvn -o clean install              离线模式，只用本地仓库（网络差时应急）
    mvn versions:display-dependency-updates
                                      列出所有可升级的依赖（需 versions-maven-plugin）

  常见问题定位：
    · 改了代码不生效          → 检查第 5 节 useIncrementalCompilation 与 IDE 的自动编译
    · 参数绑定报错 not specified → 检查第 5 节 parameters 是否为 true
    · 编译报 jakarta/javax 找不到 → Spring Boot 3 已统一用 jakarta.*，旧代码的 javax.* 需替换
    · 依赖下载卡在插件阶段    → 检查第 7 节 pluginRepositories 是否配了国内镜像
  ============================================================================
-->

</project>
