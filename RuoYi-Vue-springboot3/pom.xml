<?xml version="1.0" encoding="UTF-8"?>
<!--
  若依管理系统 - 父工程 POM 文件
  作用：作为整个项目的"总控中心"，统一管理所有子模块的依赖版本、构建插件和仓库配置。
  注意：父工程本身不写业务代码，packaging=pom，只做"版本管家"和"模块聚合"。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven 模型版本，固定为 4.0.0，无需修改 -->
	<modelVersion>4.0.0</modelVersion>

    <!-- ==================== 项目基本信息 ==================== -->
    <!-- groupId：组织/公司的唯一标识，通常用反向域名，如 com.ruoyi -->
    <groupId>com.ruoyi</groupId>
    <!-- artifactId：项目/模块的唯一标识，即项目名 -->
    <artifactId>ruoyi</artifactId>
    <!-- version：项目版本号，3.9.2 是若依当前发布版本 -->
    <version>3.9.2</version>

    <!-- 项目显示名称 -->
    <name>ruoyi</name>
    <!-- 项目官网地址 -->
    <url>http://www.ruoyi.vip</url>
    <!-- 项目描述 -->
    <description>若依管理系统</description>

    <!-- ==================== 全局属性/版本号统一管理 ==================== -->
    <!--
      properties 的作用：把所有第三方库的版本号集中在这里定义，
      子模块通过 ${变量名} 引用。好处是升级版本时只改这一处，
      避免多个模块版本不一致导致的冲突。
    -->
    <properties>
        <!-- 若依自身子模块的版本号，与父工程 version 保持一致 -->
        <ruoyi.version>3.9.2</ruoyi.version>
        <!-- 源码文件编码格式，统一 UTF-8 防止中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 报告输出编码格式 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JDK 编译版本，若依 SpringBoot3 版本要求 Java 17+ -->
        <java.version>17</java.version>
        <!-- Spring Boot 框架版本 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- MyBatis 与 Spring Boot 整合的启动器版本 -->
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
        <!-- 阿里巴巴 Druid 数据库连接池版本 -->
        <druid.version>1.2.28</druid.version>
        <!-- Yauaa：解析客户端 User-Agent（识别操作系统、浏览器、设备）的库 -->
        <yauaa.version>8.2.0</yauaa.version>
        <!-- Kaptcha：谷歌验证码生成库，用于登录图形验证码 -->
        <kaptcha.version>2.3.3</kaptcha.version>
        <!-- PageHelper：MyBatis 分页插件的 Spring Boot 启动器版本 -->
        <pagehelper.boot.version>2.1.1</pagehelper.boot.version>
        <!-- 阿里巴巴 Fastjson2：高性能 JSON 序列化/反序列化库 -->
        <fastjson.version>2.0.64</fastjson.version>
        <!-- OSHI：获取服务器硬件信息（CPU、内存、磁盘等），用于系统监控页面 -->
        <oshi.version>7.4.4</oshi.version>
        <!-- Apache Commons IO：文件 IO 操作工具类 -->
        <commons.io.version>2.22.0</commons.io.version>
        <!-- Apache POI：操作 Excel 文件的库（导入导出功能） -->
        <poi.version>5.5.1</poi.version>
        <!-- Apache Velocity：模板引擎，代码生成器用它渲染 Java/XML/Vue 模板 -->
        <velocity.version>2.3</velocity.version>
        <!-- JJWT：生成和解析 JWT Token 的库，用于登录鉴权 -->
        <jwt.version>0.9.1</jwt.version>
        <!-- JAXB API：XML 与 Java 对象互转的 API（Java 11+ 已从 JDK 移除，需单独引入） -->
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <!-- Springdoc OpenAPI：自动生成 Swagger 接口文档的库（替代旧的 springfox） -->
        <springdoc.version>2.9.0</springdoc.version>
    </properties>

    <!-- ==================== 依赖版本声明（dependencyManagement） ==================== -->
    <!--
      重要区别：
      - <dependencies>：直接引入依赖，子模块会自动继承
      - <dependencyManagement>：只"声明版本号"，不实际引入依赖。
        子模块需要用到某个依赖时，自己写 <dependency> 但不用写 <version>，
        版本号由这里统一控制。这样可以避免子模块版本冲突。
    -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot 依赖总集：import 方式引入，会把 Spring Boot 官方维护的几百个依赖版本全部导入，
                 子模块引入 spring-boot-starter-xxx 时无需写版本号 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 阿里巴巴 Druid 数据库连接池（Spring Boot 3 专用版本） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- Yauaa：解析 HTTP 请求头中的 User-Agent，识别用户用的什么浏览器/操作系统，
                 用于"登录日志"和"在线用户"页面显示客户端信息 -->
            <dependency>
                <groupId>nl.basjes.parse.useragent</groupId>
                <artifactId>yauaa</artifactId>
                <version>${yauaa.version}</version>
            </dependency>

            <!-- PageHelper：MyBatis 物理分页插件，只需在代码里写 PageHelper.startPage(pageNum, pageSize)
                 即可自动对后续 SQL 追加 limit 分页 -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.boot.version}</version>
            </dependency>

            <!-- MyBatis 与 Spring Boot 整合启动器：自动配置 SqlSessionFactory、Mapper 扫描等 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- JAXB API：XML 绑定，Java 11+ 已从 JDK 中移除，需显式引入。
                 主要用于某些第三方库（如 poi、验证码）内部依赖 -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>

            <!-- OSHI：跨平台获取服务器硬件信息（CPU使用率、内存、磁盘、JVM等），
                 若依"系统监控-服务器信息"页面的数据来源 -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- Springdoc OpenAPI：自动扫描 Controller 生成在线接口文档（Swagger UI），
                 访问地址通常是 /swagger-ui.html 或 /doc.html -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Apache Commons IO：文件读写、复制、删除等常用 IO 工具类，简化文件操作代码 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>

            <!-- Apache POI OOXML：操作 .xlsx 格式 Excel（若依的"导入导出"功能底层用它） -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- Apache Velocity 模板引擎核心：代码生成器根据数据库表结构，
                 用 Velocity 模板渲染出 Entity、Mapper、Service、Controller、Vue 等代码文件 -->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.version}</version>
            </dependency>

            <!-- 阿里巴巴 Fastjson2：JSON 序列化/反序列化，若依部分工具类和 Redis 序列化用它 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson.version}</version>
            </dependency>

            <!-- JJWT：JWT（JSON Web Token）生成与解析，若依登录成功后签发 Token，
                 后续请求通过 Token 鉴权（无状态认证，不依赖 Session） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!-- Kaptcha：图形验证码生成库，登录页面的验证码图片由它生成，
                 可配置字体、颜色、干扰线、验证码长度等 -->
            <dependency>
                <groupId>pro.fessional</groupId>
                <artifactId>kaptcha</artifactId>
                <version>${kaptcha.version}</version>
            </dependency>

            <!-- ==================== 若依内部子模块依赖声明 ==================== -->
            <!-- 以下是若依自己拆分的子模块，同样在这里声明版本，子模块互相引用时不用写版本 -->

            <!-- 定时任务模块：基于 Quartz 实现的可视化定时任务管理（增删改查、立即执行、暂停恢复） -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-quartz</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 代码生成模块：根据数据库表结构一键生成前后端代码（Entity/Mapper/Service/Controller/Vue/API） -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-generator</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 框架核心模块：Spring Security 安全配置、拦截器、过滤器、数据源、Redis、异常处理等基础设施 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-framework</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 系统业务模块：用户管理、角色管理、菜单管理、部门管理、岗位管理、字典管理等核心业务 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-system</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

            <!-- 通用工具模块：字符串、日期、文件、加密、验证码、Excel 等公共工具类，被其他所有模块依赖 -->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>ruoyi-common</artifactId>
                <version>${ruoyi.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ==================== 子模块聚合 ==================== -->
    <!--
      modules 列出了父工程聚合的所有子模块，执行 mvn install 等命令时会按顺序构建这些模块。
      注意：ruoyi-admin 是启动模块（含 main 方法），通常放第一个；
      模块间有依赖关系时 Maven 会自动调整构建顺序（被依赖的先构建）。
    -->
    <modules>
        <module>ruoyi-admin</module>       <!-- 启动模块：Spring Boot 启动类、配置文件、Controller 入口 -->
        <module>ruoyi-framework</module>   <!-- 框架核心：安全、拦截器、数据源、Redis、异常处理 -->
        <module>ruoyi-system</module>      <!-- 系统业务：用户/角色/菜单/部门/字典等 -->
        <module>ruoyi-quartz</module>      <!-- 定时任务：Quartz 可视化调度 -->
        <module>ruoyi-generator</module>   <!-- 代码生成：一键生成前后端代码 -->
        <module>ruoyi-common</module>      <!-- 通用工具：公共工具类、常量、注解 -->
    </modules>

    <!-- 打包方式：pom 表示这是一个"父工程/聚合工程"，不打 jar/war，只做版本管理和模块聚合 -->
    <packaging>pom</packaging>

    <!-- ==================== 构建配置 ==================== -->
    <build>
        <plugins>
            <!-- Maven 编译插件：指定 Java 编译版本和编码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- parameters=true：编译时保留方法参数名，Spring MVC 按参数名绑定请求参数时需要 -->
                    <parameters>true</parameters>
                    <!-- 源码编译版本，使用 properties 中定义的 java.version（17） -->
                    <source>${java.version}</source>
                    <!-- 目标字节码版本，与 source 保持一致 -->
                    <target>${java.version}</target>
                    <!-- 编译编码 -->
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven 插件：提供 spring-boot:run 启动、spring-boot:repackage 打可执行 jar 等能力。
                 注意：这个插件在父工程声明但通常只在 ruoyi-admin（启动模块）中真正生效 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>

    <!-- ==================== 依赖下载仓库 ==================== -->
    <!--
      repositories 配置 Maven 从哪里下载依赖 jar 包。
      若依配置了阿里云 Maven 镜像，比 Maven 中央仓库（国外）下载速度快很多。
    -->
    <repositories>
        <repository>
            <!-- 仓库唯一标识 -->
            <id>public</id>
            <!-- 仓库名称 -->
            <name>aliyun nexus</name>
            <!-- 阿里云公共仓库地址，聚合了 Maven 中央仓库、Google、JCenter 等 -->
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <!-- 是否允许下载正式版（release）依赖 -->
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <!-- ==================== 插件下载仓库 ==================== -->
    <!--
      pluginRepositories 与 repositories 类似，但专门用于下载 Maven 插件（如 compiler-plugin、spring-boot-maven-plugin）。
      同样配置阿里云镜像加速插件下载。
    -->
    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <!-- 不允许下载快照版（snapshot）插件，保证构建稳定性 -->
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
